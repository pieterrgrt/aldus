---
layout: layouts/base.njk
onderdeel: consultancy
eleventyComputed:
  title: "{{ consultancy.titel }}"
permalink: /consultancy/
---
<section class="intro">
  <h1>{{ consultancy.titel }}</h1>
  <p class="lead">{{ consultancy.intro }}</p>
  {% if consultancy.contact %}<p class="meta">Contact: {{ consultancy.contact }}</p>{% endif %}
</section>

<section aria-labelledby="projecten">
  <h2 id="projecten" class="sectiekop">Projecten</h2>
  <ol class="lijst projecten">
  {% for project in collections.projecten %}
    <li>
      <a href="{{ project.url }}">{{ project.data.title }}</a>{% if project.data.concept %} <span class="label">Concept</span>{% endif %}
      <p class="projectregel">{{ project.data.opdrachtgever }} · {{ project.data.periode }}</p>
      {% if project.data.samenvatting %}<p>{{ project.data.samenvatting }}</p>{% endif %}
    </li>
  {% endfor %}
  </ol>
</section>
