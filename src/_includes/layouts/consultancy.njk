---
layout: layouts/base.njk
---
<section class="intro">
  <h1>{{ consultancy.titel }}</h1>
  <p class="lead">{{ consultancy.intro }}</p>
</section>

<section aria-labelledby="werk">
  <h2 id="werk" class="sectiekop">{{ t.watIkDoe }}</h2>
  <ol class="werk">
  {% for soort in consultancy.werk %}
    <li>
      <h3>{{ soort.titel }}</h3>
      <p>{{ soort.tekst }}</p>
    </li>
  {% endfor %}
  </ol>
</section>

{% if consultancy.aanbod.length %}
<section aria-labelledby="aanbod">
  <h2 id="aanbod" class="sectiekop">{{ t.aanbod }}</h2>
  <ul class="aanbod">
  {% for product in consultancy.aanbod %}
    <li>
      <h3>{{ product.titel }}</h3>
      <p class="prijs">{{ product.prijs }}</p>
      <p>{{ product.tekst }}</p>
    </li>
  {% endfor %}
  </ul>
  {% if consultancy.aanbodNoot %}<p class="meta">{{ consultancy.aanbodNoot }}</p>{% endif %}
</section>
{% endif %}

{% set projecten = collections["projecten_" + taal] %}
{% if projecten.length %}
<section aria-labelledby="projecten">
  <h2 id="projecten" class="sectiekop">{{ t.projecten }}</h2>
  <ol class="lijst projecten">
  {% for project in projecten %}
    <li>
      <a href="{{ project.url }}">{{ project.data.title }}</a>{% if project.data.concept %} <span class="label">{{ t.concept }}</span>{% endif %}
      <p class="projectregel">{{ project.data.opdrachtgever }} · {{ project.data.periode }}</p>
      {% if project.data.samenvatting %}<p>{{ project.data.samenvatting }}</p>{% endif %}
    </li>
  {% endfor %}
  </ol>
</section>
{% endif %}

{% include "partials/contact.njk" %}
