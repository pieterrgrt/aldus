---
layout: layouts/base.njk
---
<article class="artikel" data-pagefind-body>
  <header>
    <h1>{{ title }}</h1>
    {% if samenvatting %}<p class="lead">{{ samenvatting }}</p>{% endif %}
    <p class="meta">
      <time datetime="{{ page.date | isoDatum }}">{{ page.date | datum }}</time>
      · {{ content | leestijd }} min lezen
    </p>
  </header>
  <div class="tekst">
    {{ content | safe }}
  </div>
</article>
{% include "partials/aanmelden.njk" %}
<nav class="terug"><a href="/stukken/">← Alle stukken</a></nav>
