---
layout: layouts/base.njk
---
<article class="artikel product" data-pagefind-body>
  <header>
    <p class="sectiekop"><a href="/winkel/">{{ winkel.titel }}</a>{% if concept %} · Concept{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if samenvatting %}<p class="lead">{{ samenvatting }}</p>{% endif %}
    <dl class="feiten">
      {% if prijs %}<div><dt>Prijs</dt><dd>{{ prijs }}</dd></div>{% endif %}
      {% if soort %}<div><dt>Soort</dt><dd>{{ soort }}</dd></div>{% endif %}
      {% if levering %}<div><dt>Levering</dt><dd>{{ levering }}</dd></div>{% endif %}
      {% if voor %}<div><dt>Voor</dt><dd>{{ voor }}</dd></div>{% endif %}
    </dl>
  </header>
  <div class="tekst">
    {{ content | safe }}
  </div>
</article>
<section class="contact bestellen" aria-label="Bestellen">
  {% set product = { title: title, prijs: prijs, betaallink: betaallink } %}
  {% include "partials/bestellen.njk" %}
  <p class="meta">{{ winkel.disclaimer }}</p>
</section>
<nav class="terug"><a href="/winkel/">← Alle producten</a></nav>
