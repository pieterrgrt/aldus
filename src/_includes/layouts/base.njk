<!doctype html>
<html lang="{{ site.taal }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.titel }}</title>
  <meta name="description" content="{{ samenvatting or site.ondertitel }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#0d3793">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/fonts/source-serif-4-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="kop">
    <a class="merk" href="/"><img src="/merk/aldus-beeldmerk.svg" alt="" width="40" height="40">{{ site.titel }}</a>
    <nav aria-label="Hoofdmenu">
      <a href="/stukken/"{% if page.url == "/stukken/" %} aria-current="page"{% endif %}>Alle stukken</a>
    </nav>
  </header>
  <main id="inhoud">
    {{ content | safe }}
  </main>
  <footer class="voet">
    <p>{{ site.titel }} · {{ site.url | replace("https://", "") }}</p>
  </footer>
</body>
</html>
