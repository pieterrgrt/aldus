{%- set vertaling = collections.all | vertaling(page.inputPath) -%}
<!doctype html>
<html lang="{{ taal }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.titel }}</title>
  <meta name="description" content="{{ samenvatting or site.ondertitel }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- if vertaling %}
  <link rel="alternate" hreflang="{{ taal }}" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ t.andere.taal }}" href="{{ site.url }}{{ vertaling }}">
  {%- endif %}
  <meta name="theme-color" content="#0d3793">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/fonts/source-serif-4-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="kop">
    <a class="merk" href="{{ t.url.home }}"><img src="/merk/aldus-beeldmerk.svg" alt="" width="40" height="40">{{ site.titel }}</a>
    <nav aria-label="{{ t.hoofdmenu }}">
      <a href="{{ t.url.zoeken }}"{% if page.url == t.url.zoeken %} aria-current="page"{% endif %}>{{ t.zoeken }}</a>
      <a href="{{ t.url.stukken }}"{% if page.url == t.url.stukken %} aria-current="page"{% endif %}>{{ t.alleStukken }}</a>
      {% if consultancy.klaar or eleventy.env.runMode != "build" %}<a href="{{ t.url.consultancy }}"{% if onderdeel == "consultancy" %} aria-current="page"{% endif %}>{{ consultancy.titel }}</a>{% endif %}
      {% if winkel.klaar or eleventy.env.runMode != "build" %}<a href="{{ t.url.winkel }}"{% if onderdeel == "winkel" %} aria-current="page"{% endif %}>{{ winkel.titel }}</a>{% endif %}
      {% if nieuwsbrief.lijst or eleventy.env.runMode != "build" %}<a href="{{ t.url.nieuwsbrief }}"{% if onderdeel == "nieuwsbrief" %} aria-current="page"{% endif %}>{{ t.nieuwsbrief }}</a>{% endif %}
      <a class="taal" href="{{ vertaling or teksten[t.andere.taal].url.home }}" hreflang="{{ t.andere.taal }}" lang="{{ t.andere.taal }}">{{ t.andere.naam }}</a>
    </nav>
  </header>
  <main id="inhoud">
    {{ content | safe }}
  </main>
  <footer class="voet">
    <p>{{ site.titel }} · {{ site.url | replace("https://", "") }}</p>
  </footer>
</body>
</html>
