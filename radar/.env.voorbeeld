# Kopieer naar .env en vul in. .env komt niet in git.

# Miniflux: Instellingen → API-sleutels → Nieuwe sleutel.
MINIFLUX_URL=https://reader.alduslab.eu
MINIFLUX_TOKEN=
# Welke categorieën meetellen (namen zoals in Miniflux, kommagescheiden). Leeg = alle feeds.
MINIFLUX_CATEGORIEEN=Regelgeving

# Claude-API: console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Optioneel: overzicht ook als concept-campagne in Listmonk zetten.
# API-gebruiker aanmaken in Listmonk: Admin → Users → New → type "API".
LISTMONK_URL=
LISTMONK_API_GEBRUIKER=
LISTMONK_API_TOKEN=
LISTMONK_LIJST_ID=
